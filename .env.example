# PostHog product analytics.
#
# Local: copy this file to `.env.local` (gitignored) and fill in the key.
# Deploys: set the same variables in the Netlify site's build environment.
#
# Leave unset to disable analytics — `vite dev` logs events to the console
# either way and never sends them.
#
# Find the key in PostHog under Settings -> Project -> API Keys ("Project API
# Key", starts with `phc_`). It is write-only ingest and ships in the bundle.
VITE_POSTHOG_KEY=

# Only needed if the PostHog project is on EU cloud.
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
